# ========================================================
# Backend Service URLs
# ========================================================

# Base URL of the Spring Boot backend service
BACKEND_URL=https://invetedyoubackend.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://invetedyoubackend.onrender.com

# Backend REST API Base URL (v1)
# Use '/api/v1' to proxy requests through Next.js rewrites, or 'https://invetedyoubackend.onrender.com/api/v1' for direct API calls
NEXT_PUBLIC_API_URL=/api/v1

# Backend Media / Uploads URL
NEXT_PUBLIC_MEDIA_URL=https://invetedyoubackend.onrender.com/uploads

# Notification Service URL (Internal microservice)
NOTIFICATION_SERVICE_URL=https://notificationservice-72gx.onrender.com

# ========================================================
# Frontend Application Configuration
# ========================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
